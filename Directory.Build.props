<Project>
  <!-- Self-contained: does NOT import the parent (Windows/WPF/DI) Directory.Build.props.
       MSBuild stops at the first Directory.Build.props found walking up, so this isolates
       the cross-platform CLI edition from the Windows project's packages and settings. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
